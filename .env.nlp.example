# Lokaler NLP + IP Schutz Stack Configuration
# Kopiere zu .env.nlp und passe Werte an

# Allgemein
STACK_NAME=local-nlp-ip
NETWORK_NAME=nlp_net

# Postgres + pgvector
POSTGRES_USER=nlp
POSTGRES_PASSWORD=ChangeMeStrong!
POSTGRES_DB=nlpdb
POSTGRES_PORT=5432

# Milvus (Alternative zu pgvector) - optional
MILVUS_ENABLE=false

# Embedding Modell (HF Pfad oder lokal gecachter Ordner)
EMBED_MODEL=sentence-transformers/all-MiniLM-L12-v2

# API Keys (Platzhalter - NICHT committen)
WIPO_USER_AGENT=YourOrg-IP-Research
EPO_API_KEY=YOUR_EPO_KEY
EPO_API_SECRET=YOUR_EPO_SECRET

# Signatur / Provenance
SIGNING_METHOD=hash-only   # hash-only | minisign (Beispiel)
HASH_ALGO=sha256

# Access Token für internen Gateway
INTERNAL_API_TOKEN=ReplaceWithGeneratedToken

# OPA Policy Pfad
OPA_POLICY_DIR=/policies

# Klassifizierung Default Label
DEFAULT_CLASSIFICATION=internal
