# Environment variables for EU AI Pact development
# Copy to .env and adjust values

# Domains
DOMAIN_ROOT=eu-ai-pact.local
DOMAIN_API=api.eu-ai-pact.local
DOMAIN_MCP=mcp.eu-ai-pact.local
DOMAIN_WASM=wasm.eu-ai-pact.local

# MCP Server
MCP_PORT=7000
MCP_BASE_PATH=/mcp

# Wasmtime Host
WASM_HOST_PORT=8080
WASM_BASE_PATH=/validate

# API Configuration
API_PORT=3000
API_BASE_PATH=/api

# EU AI Act Configuration
EU_AI_ACT_VERSION=2024
COMPLIANCE_THRESHOLD=80
RISK_ASSESSMENT_ENABLED=true
